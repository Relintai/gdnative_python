ARG img_version
FROM pandemonium-fedora:${img_version}




RUN dnf -y install --setopt=install_weak_deps=False \
	openssl openssl-libs python-zstandard wine msitools wget && \
  $(command -v wine64 || command -v wine || false) wineboot --init && while pgrep wineserver > /dev/null; do sleep 1; done && \
  mkdir -p /opt && \
  cd /opt && \
  git clone https://github.com/mstorsjo/msvc-wine.git && \
  mv msvc-wine msvc && \
  cd msvc && \
  git checkout 5dd115047b7ddcbb53cbc8b5b14163a20f4334fe && \
  PYTHONUNBUFFERED=1 ./vsdownload.py --accept-license --dest /opt/msvc && \
  ./install.sh /opt/msvc && \



#rm lowercase fixinclude install.sh vsdownload.py && \
#rm -rf wrappers

CMD /bin/bash
